FROM node:24-alpine

WORKDIR /usr/src/app

# -----------------------------------------------------------
# 1. SETUP SHARED LIB
# -----------------------------------------------------------
COPY shared-lib ./shared-lib
WORKDIR /usr/src/app/shared-lib

# Cài đặt dependency cho lib (để có bcryptjs, uuid, sequelize...)
RUN npm install

# Build lib
RUN npm run build

# [QUAN TRỌNG] TUYỆT ĐỐI KHÔNG XÓA node_modules Ở ĐÂY!
# Nếu xóa ở đây, bước build bên dưới sẽ chết ngay lập tức (như lỗi bạn đang gặp).

# -----------------------------------------------------------
# 2. SETUP & BUILD PAYMENT SERVICE
# -----------------------------------------------------------
WORKDIR /usr/src/app/payment-attendance-service

COPY payment-attendance-service/package*.json ./

# Cài đặt dependency cho service
RUN npm install

COPY payment-attendance-service .

# Build Service
# Lúc này tsc sẽ tìm thấy các thư viện trong ../shared-lib/node_modules -> Build THÀNH CÔNG
RUN npm run build

# -----------------------------------------------------------
# 3. CLEANUP (GIẢI QUYẾT LỖI SEQUELIZE & DỌN DẸP)
# -----------------------------------------------------------
# SAU KHI BUILD XONG RỒI, giờ chúng ta mới quay lại xóa node_modules của shared-lib.
# Mục đích: Để khi app chạy (runtime), nó không bị xung đột phiên bản Sequelize.
WORKDIR /usr/src/app/shared-lib
RUN rm -rf node_modules

# Quay lại thư mục service để thiết lập lệnh chạy
WORKDIR /usr/src/app/payment-attendance-service

EXPOSE 3002

# (Tùy chọn) Xóa bớt devDependencies của service cho nhẹ
# RUN npm prune --production

CMD ["npm", "start"]