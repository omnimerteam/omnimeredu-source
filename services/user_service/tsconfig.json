{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "shared-lib": ["../shared-lib/src/index.ts"]
    },
    "strict": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["./src/common/types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "../shared-lib/src/**/*"]
}
