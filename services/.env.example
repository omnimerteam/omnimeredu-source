# ========================================
# OmniMer EDU Microservices - Environment Configuration
# ========================================

# Database Configuration - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_USER=omnimeredu_user_db
POSTGRES_DB_PAYMENT=omnimeredu_payment_db

# Database Configuration - MongoDB
MONGO_URI=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Ports
USER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002

# ========================================
# JWT Configuration (SHARED ACROSS ALL SERVICES)
# ========================================
# IMPORTANT: Use the same secrets for all services to enable
# cross-service authentication. Change these in production!

JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================================
# AWS Configuration (for S3 avatar storage)
# ========================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=omnimeredu-avatars
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ========================================
# Environment
# ========================================
NODE_ENV=development
