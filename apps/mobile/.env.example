# ==================== ENVIRONMENT ====================
ENVIRONMENT=DEV

# ==================== MICROSERVICES BASE URLs ====================
# User Service - Quản lý user, authentication, authorization, profile
USER_SERVICE_URL=http://localhost:3001

# Payment & Attendance Service - Quản lý thanh toán và điểm danh
PAYMENT_ATTENDANCE_SERVICE_URL=http://localhost:3002

# MongoDB Service - Quản lý dữ liệu từ MongoDB (courses, content, etc.)
MONGODB_SERVICE_URL=http://localhost:3003

# ==================== API GATEWAY (Optional) ====================
# Nếu sử dụng API Gateway thì uncomment dòng này
# API_GATEWAY_URL=http://localhost:8080

# ==================== OTHER CONFIGS ====================
# API timeout (milliseconds)
API_TIMEOUT=30000

# Enable logging
ENABLE_API_LOGGING=true
