# Thiết lập mặc định: Git tự động xử lý text, nhưng chúng ta sẽ ép buộc LF cho code để thống nhất giữa Windows/Mac/Linux
* text=auto

# --- NODEJS & WEB ---
# Ép buộc sử dụng LF (Line Feed) cho các file code để tránh lỗi "CRLF vs LF" khi code trên Windows
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Config files
.eslintrc text eol=lf
.prettierrc text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Lock files - Quan trọng để tránh conflict không đáng có do dòng trống hoặc xuống dòng
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf

# --- FLUTTER & DART ---
*.dart text eol=lf
*.yaml text eol=lf
pubspec.lock text eol=lf

# Android
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# iOS / macOS
# Podfile.lock nên được coi là text để thấy diff, nhưng cần cẩn thận
Podfile text eol=lf
Podfile.lock text eol=lf
*.pbxproj text eol=lf
*.plist text eol=lf
*.xib text eol=lf
*.storyboard text eol=lf

# --- BINARY FILES ---
# Đánh dấu các file nhị phân để Git không cố gắng merge text hoặc thay đổi line ending
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.otf binary
*.pdf binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.jar binary
*.keystore binary
*.jks binary
*.zip binary
*.tar.gz binary
*.7z binary

# --- DOCUMENTATION ---
*.md text eol=lf
